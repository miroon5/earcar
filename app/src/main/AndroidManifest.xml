<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!--
      조회(read) 퍼미션으로 세팅을 읽고, 제어(CONTROL_*) 퍼미션으로 저장한 세팅을 이 차에 적용한다.
      제어 퍼미션 이름은 Vehicle SDK 2.3.2의 set… 메서드에 붙은 @RequiresPermission 값이다.
      네트워크는 쓰지 않으므로 INTERNET 퍼미션이 없다 (저장은 기기 로컬만).
    -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />           <!-- HVAC: 온도, 풍량, 열선, 통풍 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />            <!-- Light: 앰비언트 -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />             <!-- Seat: 위치(참고용) -->
    <uses-permission android:name="pleos.car.permission.READ_CAR_STEERING" />     <!-- SteeringWheel: 열선 -->
    <uses-permission android:name="pleos.car.permission.CAR_MIRRORS" />           <!-- SideMirror: 열선 -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />              <!-- CarInfo: 차종 표시 -->
    <uses-permission android:name="pleos.car.permission.READ_CAR_DISPLAY_UNITS" /> <!-- Display: 온도 단위 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />             <!-- DrivingMode -->
    <uses-permission android:name="pleos.car.permission.CAR_TOLL" />              <!-- Toll: 하이패스 음량 -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />           <!-- Window: 스마트 글라스 -->

    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />   <!-- 온도, 풍량, A/C, 핸들 열선 적용 -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_SEATS" />     <!-- 시트 열선, 통풍 적용 -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />    <!-- 앰비언트 적용 -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_MIRRORS" />   <!-- 사이드미러 열선 적용 -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_TOLL" />      <!-- 하이패스 음량 적용 -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_WINDOWS" />   <!-- 스마트 글라스 적용 -->

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true">
            <!-- 주행 중에는 한 줄 상태만 보여 준다. DO 선언 + CarUxRestrictions 대응 -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
